import matplotlib.pyplot as plt

# 1. Input your exact bench press progression data
sessions = ["Session 1", "Session 2", "Session 3", "Session 4"]
raw_weights = [135, 140, 145, 150]

# 2. Calculate true strength metrics (Estimated 1RM assuming a solid 8-rep set)
reps = 8
estimated_1rm = [round(w * (1 + (reps / 30)), 1) for w in raw_weights]

# 3. Generate the progressive overload graph
plt.figure(figsize=(8, 5))
plt.plot(sessions, raw_weights, marker='o', color='blue', linewidth=2, label='Raw Weight (lbs)')
plt.plot(sessions, estimated_1rm, marker='s', color='orange', linestyle='--', linewidth=2, label='True Strength Index (e1RM)')

# 4. Interface styling and design
plt.title('2020-2027 Transformation: Bench Press Overload Curve', fontsize=12, fontweight='bold')
plt.xlabel('Training Progress', fontsize=10)
plt.ylabel('Weight (lbs)', fontsize=10)
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend(loc='upper left')

# Displays the dynamic dashboard chart
plt.show()
